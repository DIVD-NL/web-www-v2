ących opcji"},"number_input":{"increase":"Zwiększ","decrease":"Zmniejsz","range":"Od {$min} do {$max}","min":"Minimum {$min}","max":"Maksimum {$max}"},"password_input":{"show_password":"Pokaż hasło","hide_password":"Ukryj hasło"},"secret_input":{"show_secret":"Pokaż sekret","hide_secret":"Ukryj sekret"},"select_tags":{"selected_options":"Wybrane opcje","remove_x":"Usuń {$name}"},"text_editor":{"text_editor":"Edytor tekstu","code_editor":"Edytor kodu","text_style_options":"Opcje stylu tekstu","show_text_style_options":"Pokaż opcje stylu tekstu","paragraph":"Akapit","heading_1":"Nagłówek 1","heading_2":"Nagłówek 2","heading_3":"Nagłówek 3","heading_4":"Nagłówek 4","heading_5":"Nagłówek 5","heading_6":"Nagłówek 6","bulleted_list":"Lista punktowana","numbered_list":"Lista numerowana","blockquote":"Cytat blokowy","code_block":"Blok kodu","bold":"Pogrubienie","italic":"Kursywa","strikethrough":"Przekreślenie","code":"Kod","link":"Odnośnik","insert_link":"Wstaw odnośnik","edit_link":"Edytuj odnośnik","remove_link":"Usuń odnośnik","text":"Tekst","url":"URL","open_in_new_tab":"Otwórz w nowej karcie","insert_table":"Wstaw tabelę","rows":"Wiersze","columns":"Kolumny","table_options":"Opcje tabeli","show_table_options":"Pokaż opcje tabeli","insert_row_above":"Wstaw wiersz powyżej","insert_row_below":"Wstaw wiersz poniżej","insert_column_left":"Wstaw kolumnę po lewej","insert_column_right":"Wstaw kolumnę po prawej","delete_row":"Usuń wiersz","delete_column":"Usuń kolumnę","delete_table":"Usuń tabelę","insert_horizontal_rule":"Wstaw linię poziomą","alignment_options":"Opcje wyrównania","show_alignment_options":"Pokaż opcje wyrównania","align_left":"Wyrównaj do lewej","align_center":"Wyśrodkuj","align_right":"Wyrównaj do prawej","align_justify":"Wyjustuj","edit_in_markdown":"Edytuj w Markdown","edit_in_html":"Edytuj w HTML","converter_error":"Nie można włączyć trybu tekstu sformatowanego. Zamiast tego użyj zwykłego edytora tekstu.","language":"Język","plain_text":"Zwykły tekst"}}}