hema_invalid_empty_value":"Параметр `{$option}` должен быть пустой строкой.","schema_invalid_item_count":".input {$count :integer} .match $count one {{Параметр `{$option}` должен быть массивом из {$count} элемента.}} few {{Параметр `{$option}` должен быть массивом из {$count} элементов.}} many {{Параметр `{$option}` должен быть массивом из {$count} элементов.}} * {{Параметр `{$option}` должен быть массивом из {$count} элементов.}}","schema_invalid_value":"Параметр `{$option}` имеет недопустимое значение.","schema_missing_option":"Параметр `{$option}` обязателен.","schema_missing_one_of":"Требуется один из следующих параметров: {$options}.","schema_value_type":{"string":"строкой","number":"числом","integer":"целым числом","boolean":"логическим значением","array":"массивом","object":"объектом","null":"пустым"}},"warning":{"oauth_no_app_id":"Идентификатор OAuth-приложения не определён. Пользователи должны предоставить токен доступа для входа.","unsupported_ignored_option":"Параметр `{$prop}` не поддерживается в Sveltia CMS. Он будет проигнорирован.","conflicting_timezone_options":"Установлены как `picker_utc`, так и более новые параметры часового пояса (`input_timezone` или `output_utc`). Более новые параметры имеют приоритет. Рассмотрите возможность удаления `picker_utc` из вашей конфигурации.","preview_path_no_date_field":"Параметр `preview_path` использует теги даты и времени, но в коллекции нет поля DateTime, из которого их можно прочитать, поэтому ссылка на предпросмотр не будет показана.","preview_path_date_field_not_found":"Параметр `preview_path_date_field` ссылается на поле с именем `{$name}`, но поле DateTime с таким именем не определено, поэтому ссылка на предпросмотр не будет показана.","preview_path_field_not_found":"Параметр `preview_path` ссылается на `{$name}`, но такое поле не определено в коллекции, поэтому ссылка на предпросмотр не будет показана.","schema_unknown_option":"Параметр `{$option}` не определён в схеме конфигурации Sveltia CMS. Он будет проигнорирован. Проверьте, нет ли опечатки или синтаксической ошибки."},"compatibility_link":"Подробнее см. в примечаниях о совместимости: {$link}","schema_tip":"Для лучшего опыта разработки вы можете проверить свой файл конфигурации по JSON-схеме Sveltia CMS. Подробнее см. {$link}."},"local_workflow":{"indicator":"Локальный","unsupported_browser":"Локальный рабочий процесс не поддерживается в вашем браузере. Используйте Chrome или Edge.","disabled":"Локальный рабочий процесс отключён в вашем браузере. <a>Вот как его включить</a>."},"viewing_editorial_workflow":"Вы просматриваете доску редакционного процесса. Черновики: {$draft}. На рассмотрении: {$review}. Готово: {$ready}. Ожидают удаления: {$deletion}.","viewing_open_authoring_workflow":"Вы просматриваете доску редакционного процесса. Черновики: {$draft}. На рассмотрении: {$review}. Ожидают удаления: {$deletion}.","status":{"draft":"Черновик","drafts":"Черновики","in_review":"На рассмотрении","ready":"Готово","pending_deletion":"Ожидает удаления"},"workflow":{"cancel_deletion":"Отменить удаление","confirm_cancelling_deletion":"Вы уверены, что хотите отменить это удаление? Запись останется опубликованной.","confirm_completing_deletion":"Вы уверены, что хотите удалить эту запись? Она будет удалена немедленно.","deletion_pending":".input {$count :integer} .match $count 1 {{Запись помечена на удаление.}} one {{{$count} запись помечена на удаление.}} few {{{$count} записи помечены на удаление.}} many {{{$count} записей помечены на удаление.}} * {{{$count} записей помечены на удаление.}}","changes_discarded":".input {$count :integer} .match $count 1 {{Изменения отброшены.}} one {{Изменения в {$count} записи отброшены.}} few {{Изменения в {$count} записях отброшены.}} many {{Изменения в {$count} записях отброшены.}} * {{Изменения в {$count} записях отброшены.}}","cancelling_deletion":"Отмена удаления…","deletion_cancelled":"Удаление отменено.","cancelling_deletion_failed":"Не удалось отменить удаление. Попробуйте ещё раз.","unpublished_entries":"Неопубликованные записи","published_entries":"Опубликованные записи","entry_status_value":"Статус: {$status}","change_entry_status":"Изменить статус записи","changing_status":"Изменение статуса…","updating_status":"Обновление статуса…","status_updated":"Статус обновлён.","status_change_failed":"Не удалось изменить статус. Попробуйте ещё раз.","status_change_blocked":"В записи есть ошибки. Исправьте их, прежде чем менять статус.","publish_blocked":"В записи есть ошибки. Исправьте их, прежде чем публиковать.","send_for_review":"Отправить на рассмотрение","confirm_sending_for_review":"Ваши изменения сохранены как черновик. Отправить запись на рассмотрение, чтобы кто-нибудь проверил и опубликовал её?","publish_entry":"Опубликовать запись","discard_changes":"Отбросить изменения","confirm_deleting_published_entry":"Вы уверены, что хотите удалить эту запись? Она не будет удалена, пока удаление не будет опубликовано. До тех пор она останется в списке записей с пометкой «Ожидает удаления».","confirm_deleting_unpublished_entry":"Эта запись ещё не опубликована, поэтому при удалении она будет полностью отброшена.","confirm_discarding_entry_changes":"В этой записи есть неопубликованные изменения. При их отбрасывании будет восстановлена опубликованная версия. Сама запись удалена не будет.","deleting_unpublished_note_all":".input {$count :integer} .match $count 1 {{Она ещё не опубликована, поэтому ваши неопубликованные изменения будут отброшены. Опубликованная версия, если она есть, останется опубликованной.}} * {{Они ещё не опубликованы, поэтому ваши неопубликованные изменения будут отброшены. Опубликованные версии, если они есть, останутся опубликованными.}}","deleting_unpublished_note_some":".input {$count :integer} .match $count 1 {{Одна из них ещё не опубликована, поэтому ваши неопубликованные изменения будут отброшены. Опубликованная версия, если она есть, останется опубликованной.}} one {{{$count} из них ещё не опубликована, поэтому ваши неопубликованные изменения будут отброшены. Опубликованная версия, если она есть, останется опубликованной.}} few {{{$count} из них ещё не опубликованы, поэтому ваши неопубликованные изменения будут отброшены. Опубликованные версии, если они есть, останутся опубликованными.}} many {{{$count} из них ещё не опубликованы, поэтому ваши неопубликованные изменения будут отброшены. Опубликованные версии, если они есть, останутся опубликованными.}} * {{{$count} из них ещё не опубликованы, поэтому ваши неопубликованные изменения будут отброшены. Опубликованные версии, если они есть, останутся опубликованными.}}","publishing_entry":"Публикация записи…","entry_published":"Запись опубликована.","deleting_entry":"Удаление записи…","discarding_changes":"Отбрасывание изменений…","entry_deleted":"Запись удалена.","publishing_entry_failed":"Не удалось опубликовать запись. Попробуйте ещё раз.","no_entries":"Нет записей.","drag_entry":"Перетащите, чтобы изменить статус"},"open_authoring":{"fork_repository":"Создать форк репозитория","fork":"Создать форк","confirm_forking_repository":"Чтобы предложить изменения в «{$repo}», в вашей учётной записи нужно создать форк репозитория. Ваши изменения сохраняются в этом форке, и сопровождающий проверяет их перед публикацией.","fork_declined":"Чтобы предлагать изменения, вам нужен форк репозитория в вашей учётной записи.","fork_failed":"Не удалось создать форк репозитория «{$repo}» в вашей учётной записи.","permission_check_failed":"Не удалось проверить ваш доступ к репозиторию «{$repo}». Попробуйте ещё раз через некоторое время.","forking_disabled":"Репозиторий «{$repo}» не разрешает создавать форки. Попросите сопровождающего разрешить форки для него.","invitation_pending":"У вас есть ожидающее приглашение в репозиторий «{$repo}». Примите его на GitHub, а затем войдите снова.","private_repo_scope_required":"Ваш вход не включает доступ к приватным репозиториям, поэтому репозиторий «{$repo}» невозможно прочитать. Попросите сопровождающего проверить настрой