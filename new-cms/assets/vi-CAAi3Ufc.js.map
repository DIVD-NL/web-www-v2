 chi tiết: {$link}","schema_tip":"Để có trải nghiệm tốt hơn cho nhà phát triển, bạn có thể xác thực tệp cấu hình của mình dựa trên lược đồ JSON của Sveltia CMS. Xem {$link} để biết chi tiết."},"local_workflow":{"indicator":"Cục bộ","unsupported_browser":"Trình duyệt của bạn không hỗ trợ Quy trình cục bộ. Vui lòng sử dụng Chrome hoặc Edge.","disabled":"Quy trình cục bộ đang bị tắt trong trình duyệt của bạn. <a>Xem cách bật tính năng này</a>."},"viewing_editorial_workflow":"Bạn hiện đang xem bảng Quy trình biên tập. Bản nháp: {$draft}. Đang duyệt: {$review}. Sẵn sàng: {$ready}. Đang chờ xóa: {$deletion}.","viewing_open_authoring_workflow":"Bạn hiện đang xem bảng quy trình biên tập. Bản nháp: {$draft}. Đang duyệt: {$review}. Chờ xóa: {$deletion}.","status":{"draft":"Bản nháp","drafts":"Bản nháp","in_review":"Đang duyệt","ready":"Sẵn sàng","pending_deletion":"Đang chờ xóa"},"workflow":{"cancel_deletion":"Hủy xóa","confirm_cancelling_deletion":"Bạn có chắc chắn muốn hủy việc xóa này không? Bài viết sẽ vẫn được xuất bản.","confirm_completing_deletion":"Bạn có chắc chắn muốn xóa bài viết này? Bài viết sẽ bị xóa ngay lập tức.","deletion_pending":".input {$count :integer} .match $count 1 {{Bài viết đã được đánh dấu để xóa.}} * {{{$count} bài viết đã được đánh dấu để xóa.}}","changes_discarded":".input {$count :integer} .match $count 1 {{Đã hủy thay đổi của bài viết.}} * {{Đã hủy thay đổi của {$count} bài viết.}}","cancelling_deletion":"Đang hủy xóa…","deletion_cancelled":"Việc xóa đã bị hủy.","cancelling_deletion_failed":"Không thể hủy thao tác xóa. Vui lòng thử lại.","unpublished_entries":"Bài viết chưa xuất bản","published_entries":"Bài viết đã xuất bản","entry_status_value":"Trạng thái: {$status}","change_entry_status":"Đổi trạng thái bài viết","changing_status":"Đang thay đổi trạng thái…","updating_status":"Đang cập nhật trạng thái…","status_updated":"Đã cập nhật trạng thái.","status_change_failed":"Không thể thay đổi trạng thái. Vui lòng thử lại.","status_change_blocked":"Bài viết còn lỗi. Vui lòng sửa lỗi trước khi thay đổi trạng thái.","publish_blocked":"Bài viết có lỗi. Vui lòng sửa lỗi trước khi xuất bản.","send_for_review":"Gửi duyệt","confirm_sending_for_review":"Các thay đổi của bạn đã được lưu thành bản nháp. Bạn có muốn gửi bài viết đi duyệt để người khác xem xét và xuất bản không?","publish_entry":"Xuất bản bài viết","discard_changes":"Hủy thay đổi","confirm_deleting_published_entry":"Bạn có chắc chắn muốn xóa bài viết này? Bài viết chỉ bị xóa sau khi thay đổi được xuất bản. Trước lúc đó, bài viết vẫn xuất hiện trong danh sách với trạng thái Đang chờ xóa.","confirm_deleting_unpublished_entry":"Bài viết này chưa được xuất bản nên sẽ bị xóa vĩnh viễn.","confirm_discarding_entry_changes":"Bài viết này có các thay đổi chưa xuất bản. Nếu hủy, nội dung sẽ trở về phiên bản đã xuất bản. Bài viết sẽ không bị xóa.","deleting_unpublished_note_all":".input {$count :integer} .match $count 1 {{Bài viết chưa được xuất bản nên các thay đổi chưa xuất bản sẽ bị hủy. Phiên bản đã xuất bản vẫn được giữ nguyên.}} * {{{$count} bài viết chưa được xuất bản nên các thay đổi chưa xuất bản sẽ bị hủy. Các phiên bản đã xuất bản vẫn được giữ nguyên.}}","deleting_unpublished_note_some":".input {$count :integer} .match $count 1 {{Một bài viết chưa được xuất bản nên các thay đổi chưa xuất bản sẽ bị hủy. Phiên bản đã xuất bản vẫn được giữ nguyên.}} * {{{$count} bài viết chưa được xuất bản nên các thay đổi chưa xuất bản sẽ bị hủy. Các phiên bản đã xuất bản vẫn được giữ nguyên.}}","publishing_entry":"Đang xuất bản bài viết…","entry_published":"Đã xuất bản bài viết.","deleting_entry":"Đang xóa bài viết…","discarding_changes":"Đang hủy các thay đổi…","entry_deleted":"Đã xóa bài viết.","publishing_entry_failed":"Không thể xuất bản bài viết này. Vui lòng thử lại.","no_entries":"Không có bài viết nào.","drag_entry":"Kéo để thay đổi trạng thái"},"open_authoring":{"fork_repository":"Tạo bản fork của kho mã nguồn","fork":"Fork","confirm_forking_repository":"Để đề xuất thay đổi cho “{$repo}”, cần tạo một bản fork của kho mã nguồn trên tài khoản của bạn. Các thay đổi của bạn sẽ được lưu vào bản fork đó và được người quản trị xem xét trước khi xuất bản.","fork_declined":"Bạn cần có một bản fork của kho mã nguồn trên tài khoản của mình để đề xuất thay đổi.","fork_failed":"Không thể tạo bản fork của kho mã nguồn “{$repo}” trên tài khoản của bạn.","permission_check_failed":"Không thể kiểm tra quyền truy cập của bạn vào kho mã nguồn “{$repo}”. Vui lòng thử lại sau giây lát.","forking_disabled":"Kho mã nguồn “{$repo}” không cho phép fork. Hãy đề nghị người quản trị bật tính năng fork cho kho này.","invitation_pending":"Bạn có một lời mời đang chờ vào kho mã nguồn “{$repo}”. Hãy chấp nhận lời mời trên GitHub rồi đăng nhập lại.","private_repo_scope_required":"Phiên đăng nhập của bạn không bao gồm quyền truy cập các kho mã nguồn riêng tư, vì vậy không thể đọc kho mã nguồn “{$repo}”. Hãy đề nghị người quản trị kiểm tra cài đặt xác thực của CMS.","publish_unsupported":"Chỉ người quản trị mới có thể xuất bản thay đổi lên trang web này. Thay vào đó, hãy đánh dấu bài viết là “Đang duyệt” và sẽ có người xem xét.","direct_commit_unsupported":"Không thể thực hiện thay đổi này trực tiếp. Chỉ có thể đề xuất các chỉnh sửa bài viết để duyệt.","contributing_via_fork":"Các thay đổi của bạn được lưu vào bản fork của kho mã nguồn này tại “{$repo}” và được xem xét trước khi xuất bản.","view_fork":"Xem bản fork"},"categories":"Danh mục","site_configuration_editor":"Trình chỉnh sửa cấu hình trang web","prefs":{"changes":{"api_key_saved":"Đã lưu khóa API.","api_key_removed":"Đã xóa khóa API.","api_key_invalid":"Khóa API được cung cấp không hợp lệ. Vui lòng kiểm tra lại và thử lại."},"error":{"permission_denied":"Quyền truy cập bộ nhớ cookie đã bị từ chối. Vui lòng kiểm tra quyền của trình duyệt của bạn và thử lại."},"appearance":{"title":"Giao diện","theme":"Chủ đề","select_theme":"Chọn chủ đề"},"theme":{"dark":"Tối","light":"Sáng"},"language":{"title":"N