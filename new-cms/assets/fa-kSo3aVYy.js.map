le":"رسانه","stock_photos":{"api_keys":{"title":"کلیدهای API سرویس تصویر استوک","description":"مدیریت کلیدهای API برای <a>سرویس‌های تصویر استوک</a>."},"field_label":"کلید API سرویس {$service}","description":"در <a {$homeHref}>API سرویس {$service}</a> ثبت‌نام کرده و <a {$apiKeyHref}>کلید API خود</a> را در اینجا وارد کنید تا تصاویر استوک رایگان را درج کنید.","credit":"تصاویر ارائه شده توسط {$service}","no_services":"هیچ <a>سرویس تصویر استوکی</a> پیکربندی نشده است."},"cloud_storage":{"api_keys":{"title":"کلیدهای API سرویس ذخیره‌سازی ابری","description":"مدیریت کلیدهای API برای <a>سرویس‌های ذخیره‌سازی ابری</a>."},"field_label":"کلید API سرویس {$service}","no_services":"هیچ <a>سرویس ذخیره‌سازی ابری</a> پیکربندی نشده است."}},"accessibility":{"title":"دسترسی‌پذیری","underline_links":{"title":"زیرخط‌دار کردن لینک‌ها","description":"نمایش زیرخط برای لینک‌ها در پیش‌نمایش ورودی و برچسب‌های رابط کاربری.","switch_label":"همیشه لینک‌ها زیرخط‌دار باشند"}},"data":{"clear_data":{"title":"پاک‌سازی داده‌ها","file_cache":{"description":"حذف محتوای فایل‌ها و تصاویر بندانگشتی ذخیره‌شده در حافظه نهان محلی برای آزاد کردن فضای ذخیره‌سازی یا رفع مشکلات ناشی از داده‌های قدیمی.","button_label":"پاک‌سازی حافظه نهان فایل‌ها","confirmation":"محتوای فایل‌ها و تصاویر بندانگشتی ذخیره‌شده در حافظه نهان محلی حذف خواهند شد. پیش‌نویس‌های ذخیره‌نشده و تنظیمات شما حفظ می‌شوند و داده‌های حذف‌شده در صورت نیاز دوباره دانلود یا تولید خواهند شد. پس از اتمام، CMS دوباره بارگذاری می‌شود."},"all_data":{"description":"حذف همه چیزهایی که CMS در این مرورگر نگه می‌دارد، از جمله فایل‌های ذخیره‌شده در حافظه نهان، پیش‌نویس‌های ذخیره‌نشده و تنظیمات. هر چیزی که قبلاً در مخزن شما ذخیره شده باشد تحت تأثیر قرار نمی‌گیرد.","button_label":"پاک کردن همه داده‌ها","confirmation":"همه داده‌های ذخیره‌شده در این مرورگر حذف خواهند شد، از جمله محتوای فایل‌های ذخیره‌شده در حافظه نهان، تصاویر بندانگشتی، پیش‌نویس‌های ذخیره‌نشده، تنظیمات و وضعیت ورود. مخزن شما تحت تأثیر قرار نمی‌گیرد، اما هر تغییری که ذخیره نکرده‌اید از دست می‌رود و باید 