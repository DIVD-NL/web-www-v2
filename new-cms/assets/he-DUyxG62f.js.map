o_workflow":"האפשרות `open_authoring` מחייבת את מצב הפרסום `editorial_workflow` או `preview`. ראו <a>תיעוד</a> לפרטים.","no_auth_methods":"האפשרות `auth_methods` חייבת לכלול שיטה אחת לפחות.","missing_media_folder":"לא הוגדרה תיקיית מדיה.","public_folder_relative_path":"התיקייה הציבורית שהוגדרה אינה תקינה. עליה להיות נתיב מוחלט המתחיל ב-„/”.","public_folder_absolute_url":"כתובת מוחלטת עבור אפשרות התיקייה הציבורית אינה נתמכת ב-Sveltia CMS.","unsupported_folder_template_tag":"האפשרות `{$option}` מכילה את תג התבנית `{$tag}`, שאינו נתמך שם. ניתן להשתמש רק בתגי תבנית של מזהה בכתובת, כגון `\\{\\{slug\\}\\}` ו-`\\{\\{year\\}\\}`, ובתגים `\\{\\{dirname\\}\\}`, `\\{\\{filename\\}\\}`, `\\{\\{extension\\}\\}`, `\\{\\{media_folder\\}\\}` ו-`\\{\\{public_folder\\}\\}`.","global_folder_template_tag":"האפשרות `{$option}` מכילה את תג התבנית `{$tag}`, שניתן להשתמש בו רק באפשרות של אוסף, של קובץ באוסף או של שדה, שבהם יש פריט למלא ממנו.","invalid_sanitize_replacement":"האפשרות `sanitize_replacement` מוגדרת כ-`{$replacement}`, אך היא מכילה תו שלא ניתן להשתמש בו במזהה בכתובת, ולכן אינה יכולה לשמש כתחליף.","invalid_url_option":"האפשרות `{$option}` מוגדרת כ-`{$url}`, אך עליה להיות כתובת מוחלטת המתחילה ב-`https://` או ב-`http://`.","invalid_publish_mode_stages":"האפשרות `stages` של `publish_mode` חייבת להתחיל ב-`draft` ולמנות את השלבים בסדר `draft`, `pending_review`, `pending_publish`, בלי לחזור על אף אחד מהם.","i18n_no_locales":"האפשרות `i18n.locales` חייבת למנות שפה אחת לפחות.","i18n_invalid_default_locale":"האפשרות `default_locale` מוגדרת כ-`{$locale}`, אך היא אינה אחת מ-`locales`.","i18n_invalid_initial_locale":"האפשרות `initial_locales` מכילה את `{$locale}`, אך היא אינה אחת מ-`locales`.","i18n_no_collections":"האפשרות `i18n` מוגדרת ברמה העליונה, אך לאף אחד מהאוספים או מהקבצים הבודדים אין את האפשרות `i18n`, ולכן אין תוכן שניתן לתרגם. הוסיפו `i18n: true` לאוספים ולקבצים הבודדים שברצונכם לתרגם.","invalid_transformation_key":"האפשרות `transformations` מכילה מפתח `{$key}` שאינו נתמך. עליו להיות `raster_image`, `svg` או פורמט תמונה רסטרית נתמך.","invalid_transformation_quality":"האפשרות `quality` של ההמרה `{$key}` אינה תקינה. עליה להיות מספר שלם בין 0 ל-100.","invalid_transformation_size":"האפשרות `{$prop}` של ההמרה `{$key}` אינה תקינה. עליה להיות מספר שלם חיובי.","missing_asset_collection_name":"לאוסף המדיה {$count} חייבת להיות אפשרות `name` המוגדרת כמחרוזת שאינה ריקה.","invalid_asset_collection_name":"שם אוסף המדיה `{$name}` אינו תקין. אסור שיכיל תווים מיוחדים.","duplicate_asset_collection_name":"שמות אוספי מדיה חייבים להיות ייחודיים, אך `{$name}` מופיע יותר מפעם אחת.","invalid_collection_no_options":"לאוסף חייבת להיות מוגדרת אחת מהאפשרויות `folder`, `file`, `files` או `divider`.","invalid_collection_multiple_options":"לאוסף אסור שתהיה יותר מאחת מהאפשרויות `folder`, `file`, `files` ו-`divider`.","file_format_mismatch":"הסיומת `{$extension}` אינה תואמת לפורמט `{$format}`.","front_matter_body_field_not_text":"השדה `{$name}` נשמר כגוף המסמך מתחת ל-front matter, שיכול להכיל טקסט בלבד — לא מספר, ערך בוליאני, רשימה או אובייקט כפי ששדה `{$widget}` מכיל. השתמשו בסוג שדה שמכיל טקסט, או שנו את שם השדה.","invalid_collection_data_file":"האפשרות `file` בערך `{$file}` אינה תקינה. עליה להיות נתיב לקובץ JSON, בלי מציין המיקום `\\{\\{locale\\}\\}`.","unsupported_collection_data_file_option":"האפשרות `{$prop}` אינה נתמכת באוסף שיש בו האפשרות `file`.","collection_data_file_workflow":"תהליך העריכה ותהליך התצוגה המקדימה, לרבות Open Authoring, אינם נתמכים באוסף שיש בו האפשרות `file`. הגדירו את האפשרות `publish_mode` של האוסף כ-`simple`.","collection_data_file_slug_tag":"האפשרות `{$prop}` אינה יכולה להכיל את התג `\\{\\{slug\\}\\}` באוסף שיש בו האפשרות `file`, מפני שהמזהה של פריט הוא מיקומו, והוא משתנה כשמסדרים את הפריטים מחדש או מוחקים אותם. השתמשו בשדה בעל ערך ייחודי במקום זאת.","invalid_slug_slash":"תבנית המזהה `{$slug}` אינה תקינה מפני שאינה יכולה להכיל לוכסנים. כדי לארגן פריטים בתיקיות משנה, השתמשו באפשרות `path` במקום ב-`slug`.","invalid_identifier_field":"האפשרות `identifier_field` מפנה אל `{$name}`, אך שדה כזה אינו מוגדר באוסף.","invalid_filter_field":"האפשרות `filter` מפנה אל `{$name}`, אך שדה כזה אינו מוגדר באוסף.","invalid_filter_no_condition":"לאפשרות `filter` חייבת להיות האפשרות `value` או `pattern` שמולה ייבדקו הפריטים.","option_field_not_found":"האפשרות `{$option}` מפנה אל `{$name}`, אך שדה כזה אינו מוגדר.","thumbnail_field_not_media":"האפשרות `thumbnail` מפנה אל `{$name}`, אך עליו להיות שדה תמונה או קובץ, ולא שדה `{$widget}`.","invalid_inline_component_fields":"מצב `inline` מחייב שדה בודד מסוג בוליאני, צבע, תאריך ושעה, מספר, קשר, בחירה או מחרוזת. בשדה קשר או בחירה אסור שהאפשרות `multiple` תהיה מופעלת.","invalid_regex":"האפשרות `{$option}` מכילה ביטוי רגולרי לא תקין `{$pattern}`, והוא מתעלם.","invalid_reorder_group":"האפשרות `reorder` מפנה לקבוצת תצוגה בשם `{$name}`, אך קבוצה כזו אינה מוגדרת באפשרות `view_groups`.","invalid_bulk_edit_field":"רשימת `fields` של האפשרות `bulk_edit` מפנה לשדה בשם `{$name}`, אך שדה כזה ברמה העליונה אינו מוגדר באוסף.","unsupported_bulk_edit_field":"לא ניתן לערוך בצורה מרוכזת את השדה `{$name}` שברשימת `fields` של האפשרות `bulk_edit`. נתמך רק שדה מסוג בוליאני, צבע, תאריך ושעה, מספר, קשר, בחירה או מחרוזת, שאינו לקריאה בלבד, שהאפשרות `multiple` אינה מופעלת בו, ושאינו נקבע אוטומטית בשמירה.","invalid_sortable_field":"האפשרות `sortable_fields` מפנה לשדה בשם `{$name}`, אך שדה כזה אינו מוגדר באוסף.","invalid_table_column_field":"האפשרות `{$option}` מפנה לשדה בשם `{$name}`, אך שדה כזה אינו מוגדר באוסף.","invalid_view_group_field":"האפשרות `view_groups` מפנה לשדה בשם `{$name}`, אך שדה כזה אינו מוגדר באוסף.","invalid_view_filter_field":"האפשרות `view_filters` מפנה לשדה בשם `{$name}`, אך שדה כזה אינו מוגדר באוסף.","missing_view_group_name":"לקבוצת התצוגה {$count} חייבת להיות אפשרות `name` המוגדרת כמחרוזת שאינה ריקה.","invalid_view_group_name":"שם קבוצת התצוגה `{$name}` אינו תקין. אסור שיכיל תווים מיוחדים.","duplicate_view_group_name":"שמות קבוצות תצוגה חייבים להיות ייחודיים, אך `{$name}` מופיע יותר מפעם אחת.","missing_view_filter_name":"למסנן התצוגה {$count} חייבת להיות אפשרות `name` המוגדרת כמחרוזת שאינה ריקה.","invalid_view_filter_no_condition":"למסנן התצוגה {$count} חייבת להיות האפשרות `pattern` או אפשרות השוואה כגון `eq` או `gte` שמולה ייבדקו הפריטים.","invalid_view_filter_name":"שם מסנן התצוגה `{$name}` אינו תקין. אסור שיכיל תווים מיוחדים.","duplicate_view_filter_name":"שמות מסנני תצוגה חייבים להיות ייחודיים, אך `{$name}` מופיע יותר מפעם אחת.","invalid_view_group_default":"האפשרות `default` של `view_groups` מוגדרת כ-`{$name}`, אך אין קבוצת תצוגה בשם הזה.","invalid_view_filter_default":"האפשרות `default` של `view_filters` מוגדרת כ-`{$name}`, אך אין מסנן תצוגה בשם הזה.","missing_collection_name":"לאוסף {$count} חייבת להיות אפשרות `name` המוגדרת כמחרוזת שאינה ריקה.","invalid_collection_name":"שם האוסף `{$name}` אינו תקין. אסור שיכיל תווים מיוחדים.","duplicate_collection_name":"שמות אוספים חייבים להיות ייחודיים, אך `{$name}` מופיע יותר מפעם אחת.","missing_collection_file_name":"לקובץ באוסף {$count} חייבת להיות אפשרות `name` המוגדרת כמחרוזת שאינה ריקה.","invalid_collection_file_name":"שם הקובץ באוסף `{$name}` אינו תקין. אסור שיכיל תווים מיוחדים.","duplicate_collection_file_name":"שמות קבצים באוסף חייבים להיות ייחודיים, אך `{$name}` מופיע יותר מפעם אחת.","collection_no_fields":"לאוסף חייבת להיות אפשרות `fields` מוגדרת עם שדה אחד לפחות.","collection_file_no_fields":"לקובץ באוסף חייבת להיות אפשרות `fields` מוגדרת עם שדה אחד לפחות.","collection_folder_i18n_required":"לאוסף חייבת להיות אפשרות `i18n` מוגדרת אם משתמשים במציין המיקום `locale` בנתיב `folder`.","invalid_collection_folder_locale":"נתיב ה-`folder` בערך `{$folder}` אינו תקין. מציין המיקום `locale` חייב לשמש פעם אחת בלבד כשם תיקייה שלם, כמו `content/\\{\\{locale\\}\\}/posts`.","collection_file_i18n_required":"לקובץ באוסף חייבת להיות אפשרות `i18n` מוגדרת אם משתמשים במציין המיקום `locale` בנתיב `file`.","collection_i18n_no_fields":"לאוסף יש את האפשרות `i18n`, אך לאף אחד מהשדות שלו אין את האפשרות `i18n`, ולכן אין שדה שניתן לתרגם. הוסיפו `i18n: true` או `i18n: duplicate` לשדות שברצונכם לתרגם.","collection_i18n_no_files":"לאוסף יש את האפשרות `i18n`, אך לאף אחד מהקבצים שלו אין את האפשרות `i18n`, ולכן אין קובץ שניתן לתרגם. הוסיפו `i18n: true` לקבצים שברצונכם לתרגם.","collection_file_i18n_no_fields":"לקובץ באוסף יש את האפשרות `i18n`, אך לאף אחד מהשדות שלו אין את האפשרות `i18n`, ולכן אין שדה שניתן לתרגם. הוסיפו `i18n: true` או `i18n: duplicate` לשדות שברצונכם לתרגם.","missing_field_name":"לשדה {$count} חייבת להיות אפשרות `name` המוגדרת כמחרוזת שאינה ריקה.","invalid_field_name":"שם השדה `{$name}` אינו תקין. אסור שיכיל תווים מיוחדים. אם ברצונכם לקנן שדות, <a>השתמשו בשדות Object במקום בסימון נקודה</a>.","duplicate_field_name":"שמות שדות חייבים להיות ייחודיים, אך `{$name}` מופיע יותר מפעם אחת.","missing_variable_type":"לסוג המשתנה {$count} חייבת להיות אפשרות `name` המוגדרת כמחרוזת שאינה ריקה.","invalid_variable_type":"שם סוג המשתנה `{$name}` אינו תקין. אסור שיכיל תווים מיוחדים.","duplicate_variable_type":"שמות סוגי משתנים חייבים להיות ייחודיים, אך `{$name}` מופיע יותר מפעם אחת.","date_field_type":"סוג השדה Date המיושן אינו נתמך ב-Sveltia CMS. השתמשו בסוג השדה DateTime עם האפשרות `type: date` במקום זאת.","hidden_field_locale_without_i18n":"האפשרות `default` של שדה מוסתר משתמשת במציין המיקום `\\{\\{locale\\}\\}`, אך i18n אינו מופעל באוסף, ולכן אין לתוכן שפה למלא בה.","invalid_timezone":"אזור זמן לא תקין: {$timeZone}. עליו להיות מזהה אזור זמן תקין של IANA, כגון `America/New_York` או `Asia/Tokyo`.","unsupported_deprecated_option":"האפשרות המיושנת `{$prop}` אינה נתמכת ב-Sveltia CMS. השתמשו באפשרות `{$newProp}` במקום זאת.","allow_multiple":"האפשרות `allow_multiple` אינה נתמכת ב-Sveltia CMS. השתמשו באפשרות `multiple` במקום זאת, שברירת המחדל שלה היא `false`.","invalid_list_field":"לשדה List אסור שיהיו האפשרויות `field`, `fields` ו-`types` יחד.","invalid_list_variable_type":"סוג המשתנה של שדה List אינו תקין. האפשרות `widget` מוגדרת כ-`{$widget}` אך עליה להיות `object`.","invalid_object_field":"לשדה Object אסור שיהיו האפשרויות `fields` ו-`types` יחד.","invalid_range_options":"האפשרות `{$min}` אינה יכולה להיות גדולה מהאפשרות `{$max}`.","invalid_step":"האפשרות `step` מוגדרת כ-`{$step}`, אך עליה להיות גדולה מאפס, או `-1` כדי לכבות את הקפיצות.","select_field_no_options":"לשדה Select חייב להיות פריט אחד לפחות באפשרות `options`.","select_field_duplicate_option":"ערכי `options` של שדה Select חייבים להיות ייחודיים, אך `{$value}` מופיע יותר מפעם אחת.","select_field_invalid_default":"האפשרות `default` של שדה Select מוגדרת כ-`{$value}`, אך היא אינה אחת מ-`options`.","list_field_no_subfields":"לאפשרות `fields` או `types` של שדה List חייב להיות פריט אחד לפחות. השמיטו את האפשרות כדי לקבל רשימה של ערכים פשוטים.","list_field_invalid_default_object":"האפשרות `default` של שדה List מכילה אובייקט, אך כל פריט חייב להיות ערך פשוט מפני שלשדה אין `fields` או `types`.","list_field_invalid_default_item":"האפשרות `default` של שדה List מכילה את `{$value}`, אך כל פריט חייב להיות אובייקט מפני שלשדה יש `fields` או `types`.","list_field_invalid_default_key":"האפשרות `default` של שדה List מכילה פריט עם המאפיין `{$key}`, אך אין תת־שדה בשם הזה.","list_field_default_missing_type":"האפשרות `default` של שדה List מכילה פריט ללא המאפיין `{$typeKey}`, שמזהה אחד מ-`types`.","list_field_invalid_default_type":"האפשרות `default` של שדה List מכילה פריט שהמאפיין `{$typeKey}` שלו הוא `{$value}`, אך הוא אינו אחד מ-`types`.","invalid_default_multiple":"האפשרות `default` חייבת להיות מערך מפני שהאפשרות `multiple` היא `true`.","invalid_default_single":"האפשרות `default` חייבת להיות ערך יחיד ולא מערך, מפני שהאפשרות `multiple` אינה `true`.","object_field_invalid_default_key":"לאפשרות `default` של שדה Object יש את המאפיין `{$key}`, אך אין תת־שדה בשם הזה.","object_field_default_missing_type":"לאפשרות `default` של שדה Object אין את המאפיין `{$typeKey}`, שמזהה אחד מ-`types`.","object_field_invalid_default_type":"המאפיין `{$typeKey}` של האפשרות `default` בשדה Object הוא `{$value}`, אך הוא אינו אחד מ-`types`.","code_field_invalid_default_object":"האפשרות `default` של שדה Code חייבת להיות מחרוזת מפני שהאפשרות `output_code_only` היא `true`.","code_field_invalid_default_key":"לאפשרות `default` של שדה Code יש את המאפיין `{$key}`, אך האפשרות `keys` מתירה רק את `{$code}` ואת `{$lang}`.","number_field_default_not_integer":"האפשרות `default` של שדה Number מוגדרת כ-`{$value}`, אך עליה להיות מספר שלם מפני שהאפשרות `value_type` היא `{$valueType}`.","number_field_default_not_number":"האפשרות `default` של שדה Number מוגדרת כ-`{$value}`, אך עליה להיות מספר מפני שהאפשרות `value_type` היא `{$valueType}`.","object_field_no_subfields":"לאפשרות `fields` או `types` של שדה Object חייב להיות פריט אחד לפחות.","relation_field_invalid_collection":"האוסף `{$collection}` שאליו מפנים אינו תקין או שאינו מוגדר.","relation_field_invalid_collection_file":"הקובץ `{$file}` שאליו מפנים אינו תקין או שאינו מוגדר.","relation_field_missing_file_name":"חובה להגדיר את האפשרות `file` עבור קשר לאוסף קבצים.","relation_field_invalid_value_field":"שדה הערך `{$field}` שאליו מפנים אינו תקין או שאינו מוגדר.","relation_field_array_file_slug":"הקשר לאוסף `{$collection}` אינו יכול לשמור את הערך `\\{\\{slug\\}\\}`, מפני שהמזהה של פריט באוסף שיש בו האפשרות `file` הוא מיקומו, והוא משתנה כשמסדרים את הפריטים מחדש או מוחקים אותם. הגדירו את האפשרות `value_field` לשדה בעל ערך ייחודי במקום זאת.","relation_field_array_file_workflow":"לאוסף שיש בו האפשרות `file` אינו יכול להיות קשר לאוסף `{$collection}`, שמשתמש בתהליך העריכה או בתהליך התצוגה המקדימה, מפני שלא ניתן לעדכן בקובץ את ההפניות לפריט ששמו שונה או שנמחק שם.","relation_field_invalid_display_field":"שדה התצוגה `{$field}` שאליו מפנים אינו תקין או שאינו מוגדר.","relation_field_invalid_search_field":"שדה החיפוש `{$field}` שאליו מפנים אינו תקין או שאינו מוגדר.","relation_field_invalid_filter_field":"שדה הסינון `{$field}` שאליו מפנים אינו תקין או שאינו מוגדר.","unexpected":"שגיאה בלתי צפויה","schema_invalid_type":"האפשרות `{$option}` חייבת להיות {$type}.","schema_invalid_enum":"האפשרות `{$option}` חייבת להיות אחד מהערכים האלה: {$values}.","schema_invalid_const":"האפשרות `{$option}` חייבת להיות `{$value}`.","schema_invalid_empty_value":"האפשרות `{$option}` חייבת להיות מחרוזת ריקה.","schema_invalid_item_count":"האפשרות `{$option}` חייבת להיות מערך של {$count} פריטים.","schema_invalid_value":"לאפשרות `{$option}` יש ערך לא תקין.","schema_missing_option":"האפשרות `{$option}` נדרשת.","schema_missing_one_of":"אחת מהאפשרויות האלה נדרשת: {$options}.","schema_value_type":{"string":"מחרוזת","number":"מספר","integer":"מספר שלם","boolean":"ערך בוליאני","array":"מערך","object":"אובייקט","null":"ריק"}},"warning":{"oauth_no_app_id":"לא הוגדר מזהה יישום OAuth. המשתמשים יידרשו לספק אסימון גישה כדי להתחבר.","unsupported_ignored_option":"האפשרות `{$prop}` אינה נתמכת ב-Sveltia CMS. המערכת תתעלם ממנה.","publish_mode_stages_ignored":"האפשרות `stages` של `publish_mode` חלה רק על מצב הפרסום `editorial_workflow`, ולכן המערכת מתעלמת ממנה עם `{$type}`.","conflicting_timezone_options":"גם `picker_utc` וגם אפשרויות אזור הזמן החדשות (`input_timezone` או `output_utc`) מוגדרות. לאפשרויות החדשות יש עדיפות. שקלו להסיר את `picker_utc` מהתצורה שלכם.","preview_path_no_date_field":"האפשרות `preview_path` משתמשת בתגי תאריך ושעה, אך לאוסף אין שדה DateTime לקרוא מהם, ולכן קישור התצוגה המקדימה לא יוצג.","preview_path_date_field_not_found":"האפשרות `preview_path_date_field` מפנה לשדה בשם `{$name}`, אך לא מוגדר שדה DateTime בשם הזה, ולכן קישור התצוגה המקדימה לא יוצג.","preview_path_field_not_found":"האפשרות `preview_path` מפנה אל `{$name}`, אך שדה כזה אינו מוגדר באוסף, ולכן קישור התצוגה המקדימה לא יוצג.","missing_identifier_field":"לאוסף אין שדה `{$name}` שישמש לשמות של פריטים חדשים, ולכן כל פריט חדש מקבל מזהה אקראי. הוסיפו שדה `{$name}`, או הגדירו את האפשרות `identifier_field` או `slug`.","slug_i18n_ineffective":"לאפשרות `i18n` של `slug` אין השפעה, מפני שהאוסף אינו משתמש במבנה ה-i18n מסוג `multiple_files`, `multiple_folders` או `multiple_root_folders`, שבהם לכל שפה יש קובץ משלה.","slug_template_ignored":"המערכת מתעלמת מהאפשרות `template` של `slug`, מפני שהאפשרות `auto_increment` ממספרת את המזהים במקום זאת.","locale_not_omitted_from_file_path":"לא ניתן להסיר את מציין המיקום `locale` מנתיב ה-`file` בערך `{$file}`, ולכן שפת ברירת המחדל נשארת בו למרות אפשרות ה-i18n בשם `omit_default_locale_from_file_path`. כדי להשמיט את השפה, השתמשו במציין המיקום כשם תיקייה שלם, כמו `\\{\\{locale\\}\\}/about.md`, או בין שם הקובץ לסיומת, כמו `about.\\{\\{locale\\}\\}.md`. כדי להשאיר אותה, הגדירו את האפשרות כ-`false` באפשרות ה-`i18n` של הקובץ.","i18n_not_configured":"האפשרות `i18n` מופעלת, אך i18n אינו מוגדר ברמה העליונה של התצורה או באוסף, ולכן לאפשרות אין השפעה.","empty_public_folder":"האפשרות `public_folder` היא מחרוזת ריקה, ולכן נתיב ה-`media_folder` משמש לנתיבי קובצי המדיה הנשמרים בפריטים במקום זאת. הסירו את האפשרות, או הגדירו אותה לנתיב שברצונכם להשתמש בו, כגון `/images`.","schema_unknown_option":"האפשרות `{$option}` אינה מוגדרת בסכמת התצורה של Sveltia CMS. המערכת תתעלם ממנה. בדקו אם יש שגיאת כתיב או שגיאת תחביר."},"compatibility_link":"ראו את הערות התאימות לפרטים: {$link}","schema_tip":"לחוויית פיתוח טובה יותר, אפשר לבדוק את קובץ התצורה שלכם מול סכמת ה-JSON של Sveltia CMS. ראו {$link} לפרטים."},"local_workflow":{"indicator":"מקומי","unsupported_browser":"תהליך העבודה המקומי אינו נתמך בדפדפן שלכם. השתמשו ב-Chrome או ב-Edge במקום זאת.","disabled":"תהליך העבודה המקומי מושבת בדפדפן שלכם. <a>כך מפעילים אותו</a>."},"viewing_editorial_workflow":"זהו לוח תהליך העריכה. טיוטות: {$draft}. בבדיקה: {$review}. מוכנים: {$ready}. ממתינים למחיקה: {$deletion}.","viewing_open_authoring_workflow":"זהו לוח תהליך העריכה. טיוטות: {$draft}. בבדיקה: {$review}. ממתינים למחיקה: {$deletion}.","viewing_editorial_workflow_without_review":"זהו לוח תהליך העריכה. טיוטות: {$draft}. מוכנים: {$ready}. ממתינים למחיקה: {$deletion}.","viewing_preview_workflow":"זהו עמוד הטיוטות. טיוטות: {$draft}. ממתינים למחיקה: {$deletion}.","status":{"draft":"טיוטה","drafts":"טיוטות","in_review":"בבדיקה","ready":"מוכן","pending_deletion":"ממתין למחיקה","deploying":"בפרסום"},"workflow":{"cancel_deletion":"ביטול המחיקה","confirm_cancelling_deletion":"לבטל את המחיקה? הפריט יישאר מפורסם.","confirm_completing_deletion":"למחוק את הפריט? הוא יוסר מיד.","deletion_pending":".input {$count :integer} .match $count one {{הפריט סומן למחיקה.}} two {{שני פריטים סומנו למחיקה.}} * {{{$count} פריטים סומנו למחיקה.}}","changes_discarded":".input {$count :integer} .match $count one {{השינויים בוטלו.}} two {{השינויים בשני פריטים בוטלו.}} * {{השינויים ב-{$count} פריטים בוטלו.}}","cancelling_deletion":"מבטל מחיקה…","deletion_cancelled":"המחיקה בוטלה.","cancelling_deletion_failed":"ביטול המחיקה נכשל. אפשר לנסות שוב.","unpublished_entries":"ממתינים לפרסום","published_entries":"פורסמו","entry_status_value":"סטטוס: {$status}","change_entry_status":"שינוי סטטוס","changing_status":"משנה סטטוס…","updating_status":"מעדכן סטטוס…","status_updated":"הסטטוס עודכן.","status_change_failed":"שינוי הסטטוס נכשל. אפשר לנסות שוב.","status_change_blocked":"יש שגיאות בפריט. צריך לתקן אותן לפני שינוי הסטטוס.","publish_blocked":"יש שגיאות בפריט. צריך לתקן אותן לפני הפרסום.","send_for_review":"שליחה לבדיקה","confirm_sending_for_review":"השינויים נשמרו כטיוטה. לשלוח לבדיקה? זה פותח ענף נפרד ובונה כתובת תצוגה מקדימה, שבה אפשר לראות את השינוי באתר אמיתי לפני שהוא עולה לאוויר. הפרסום נשאר בידיך.","mark_as_ready":"סימון כמוכן","confirm_marking_as_ready":"השינויים שלכם נשמרו כטיוטה. לסמן את הפריט כמוכן כדי שניתן יהיה לפרסם אותו?","publish_entry":"פרסום הפריט","discard_changes":"ביטול השינויים","confirm_deleting_published_entry":"למחוק את הפריט? הוא לא יוסר מהאתר עד שהמחיקה תפורסם. עד אז הוא עדיין יופיע ברשימת הממתינים לפרסום.","confirm_deleting_unpublished_entry":"הפריט הזה טרם פורסם, ולכן מחיקתו תבטל אותו לגמרי.","confirm_discarding_entry_changes":"לפריט הזה יש שינויים שטרם פורסמו. ביטולם יחזיר את הגרסה המפורסמת. הפריט עצמו לא יימחק.","deleting_unpublished_note_all":".input {$count :integer} .match $count one {{הוא טרם פורסם, ולכן השינויים שלא פורסמו יבוטלו. גרסה מפורסמת, אם קיימת, תישאר.}} * {{הם טרם פורסמו, ולכן השינויים שלא פורסמו יבוטלו. גרסאות מפורסמות, אם קיימות, יישארו.}}","deleting_unpublished_note_some":".input {$count :integer} .match $count one {{אחד מהם טרם פורסם, ולכן השינויים שלא פורסמו בו יבוטלו. כל גרסה שפורסמה תישאר מפורסמת.}} two {{שניים מהם טרם פורסמו, ולכן השינויים שלא פורסמו בהם יבוטלו. כל גרסה שפורסמה תישאר מפורסמת.}} * {{{$count} מהם טרם פורסמו, ולכן השינויים שלא פורסמו בהם יבוטלו. כל גרסה שפורסמה תישאר מפורסמת.}}","confirm_publishing_entry_after_build":"לפרסם את הפריט הזה? השינויים שלכם יעלו לאוויר לאחר בנייה מחדש של האתר.","publishing_entry":"מפרסם…","entry_published":"הפריט פורסם.","deleting_entry":"מוחק פריט…","discarding_changes":"מבטל שינויים…","entry_deleted":"הפריט נמחק.","publishing_entry_failed":"הפרסום נכשל. אפשר לנסות שוב.","publish_refused_other_changes":"לא ניתן לפרסם כאן את הפריט הזה, מפני שנלווים אליו שינויים נוספים שהמערכת אינה יכולה להציג לכם. בקשו ממפתח לבדוק אותו.","publish_refused_entry_changed":"הפריט שונה מאז שפתחתם אותו. טענו מחדש את העמוד כדי לבדוק את הגרסה האחרונה לפני הפרסום.","branch_in_use":"בקשה אחרת ({$number}) כבר פתוחה עבור הפריט הזה מחוץ למערכת. בקשו ממפתח לסגור אותה קודם.","no_entries":"אין פריטים.","drag_entry":"אפשר לגרור כדי לשנות סטטוס","deploying_deletion":"מחיקה"},"commit_message":{"title":"תיאור השינוי","description_replace":"תארו את השינוי שביצעתם. התיאור נרשם בהיסטוריה יחד איתו.","description_addition":"הוסיפו הערה לתיאור שנרשם בהיסטוריה יחד עם השינוי, למשל מספר פנייה. אפשר להשאיר ריק.","message":"תיאור השינוי","addition":"הערה","preview":"תיאור: {$message}"},"open_authoring":{"fork_repository":"יצירת עותק של המאגר","fork":"עותק","confirm_forking_repository":"כדי להציע שינויים ל-„{$repo}”, יש ליצור עותק של המאגר בחשבון שלכם. השינויים שלכם נשמרים באותו עותק, ומתחזק בודק אותם לפני שהם עולים לאוויר.","fork_declined":"נדרש עותק של המאגר בחשבון שלכם כדי להציע שינויים.","fork_failed":"לא ניתן היה ליצור עותק של המאגר „{$repo}” בחשבון ש